PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX tern-shapes: <https://w3id.org/tern/shapes/tern/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

tern-shapes:CollectionBaseline
    a sh:NodeShape ;
    sh:property
        [
            sh:message "Collections must have exactly one skos:prefLabel." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:path skos:prefLabel ;
        ] ;
    sh:or (
        [
            sh:property [
                sh:message "Collections must declare at least one skos:member or skos:memberList." ;
                sh:minCount 1 ;
                sh:path skos:member ;
                sh:or (
                    [ sh:class skos:Concept ]
                    [ sh:class skos:Collection ]
                    [ sh:class skos:OrderedCollection ]
                ) ;
            ] ;
        ]
        [
            sh:property
                [
                    sh:message "Collections must declare at least one skos:member or skos:memberList." ;
                    sh:minCount 1 ;
                    sh:path skos:memberList ;
                    sh:nodeKind sh:BlankNode ;
                ] ,
                [
                    sh:message "Collection member list entries must be skos:Concept or skos:Collection." ;
                    sh:minCount 1 ;
                    sh:path ( skos:memberList rdf:rest* rdf:first ) ;
                    sh:or (
                        [ sh:class skos:Concept ]
                        [ sh:class skos:Collection ]
                        [ sh:class skos:OrderedCollection ]
                    ) ;
                ] ;
        ]
    ) ;
    sh:targetClass skos:Collection ;
.

tern-shapes:OrderedCollectionBaseline
    a sh:NodeShape ;
    sh:property
        [
            sh:message "Ordered collections must have exactly one skos:prefLabel." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:path skos:prefLabel ;
        ] ,
        [
            sh:message "Ordered collections must declare skos:memberList." ;
            sh:minCount 1 ;
            sh:path skos:memberList ;
            sh:nodeKind sh:BlankNode ;
        ] ,
        [
            sh:message "Ordered collection list entries must be skos:Concept or skos:Collection." ;
            sh:minCount 1 ;
            sh:path ( skos:memberList rdf:rest* rdf:first ) ;
            sh:or (
                [ sh:class skos:Concept ]
                [ sh:class skos:Collection ]
                [ sh:class skos:OrderedCollection ]
            ) ;
        ] ;
    sh:targetClass skos:OrderedCollection ;
.

tern-shapes:CollectionMemberConceptBaseline
    a sh:NodeShape ;
    sh:property
        [
            sh:message "Collection member concepts must have exactly one skos:prefLabel." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:path skos:prefLabel ;
        ] ,
        [
            sh:message "Collection member concepts must have at least one skos:definition." ;
            sh:minCount 1 ;
            sh:path skos:definition ;
        ] ;
    sh:targetClass skos:Concept ;
.
