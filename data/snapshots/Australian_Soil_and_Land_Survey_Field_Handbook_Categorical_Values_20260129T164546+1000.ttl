<http://linked.data.gov.au/def/tern-cv/7e5f0dda-d0f6-44fa-b113-cba696c185e3> a skos:Concept ;
    rdfs:label "calcareous material"@en ;
    dcterms:created "2024-09-26T03:26:59"^^xsd:dateTime ;
    dcterms:date "2024-09-26T03:26:59"^^xsd:dateTime,
        "2024-09-30T00:14:03"^^xsd:dateTime ;
    dcterms:description "Calcareous materials, particularly soils, contain significant amounts of calcium carbonate. Describes rocks composed largely of, or cemented by, calcium carbonate. A calcareous soil is one containing carbonate in sufficient quantity to effervesce visibly when treated with cold dilute (N) hydrochloric acid." ;
    dcterms:modified "2024-09-30T00:14:03"^^xsd:dateTime ;
    dcterms:relation "Department of Environment and Heritage, NSW Government (2017). Glossary of Terms used in Soil and Landscape Science, Office of Environment and Heritage, ISBN 978-1-76039-930-6, pp. 92" ;
    dcterms:source "Department of Environment and Heritage, NSW Government (2017). Glossary of Terms used in Soil and Landscape Science, Office of Environment and Heritage, ISBN 978-1-76039-930-6, pp. 92" ;
    skos:definition "A type of lithology whose parent material is of calcareous origin." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
    skos:notation "110" ;
    skos:note "A type of lithology whose parent material is of calcareous origin." ;
    skos:prefLabel "calcareous material"@en ;
    skos:topConceptOf <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
