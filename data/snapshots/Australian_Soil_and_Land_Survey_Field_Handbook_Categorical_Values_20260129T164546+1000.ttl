<http://linked.data.gov.au/def/tern-cv/34433228-c36c-4706-9aae-e79d1aa15b29> a skos:Concept ;
    rdfs:label "clayey sand"@en ;
    dcterms:created "2024-09-30T23:50:06"^^xsd:dateTime ;
    dcterms:date "2024-09-30T23:50:06"^^xsd:dateTime,
        "2024-10-01T00:09:14"^^xsd:dateTime ;
    dcterms:description "Slight coherence: sand grains of medium size, sticky to fingers, will form minimal ribbon of 5-15 mm, discolours fingers with clay stain. Clay content in the range from 5 - 10%." ;
    dcterms:modified "2024-10-01T00:09:14"^^xsd:dateTime ;
    skos:definition "Clayey sand is a type of soil that contains a mix of sand, clay, and silt, with sand being the dominant component." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
    skos:notation "CS" ;
