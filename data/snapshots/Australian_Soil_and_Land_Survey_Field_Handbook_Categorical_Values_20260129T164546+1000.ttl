<http://linked.data.gov.au/def/tern-cv/f8184bba-63b9-4175-8f82-6d6dfe94429e> a skos:Concept ;
    rdfs:label "quartzite"@en ;
    dcterms:created "2024-09-26T06:17:11"^^xsd:dateTime ;
    dcterms:date "2024-09-26T06:17:11"^^xsd:dateTime,
        "2024-09-30T00:17:28"^^xsd:dateTime ;
    dcterms:description "Regionally or thermally metamorphosed rock in which quartz is the primary constituent; grains have recrystallised into an interlocking mosaic texture with little or no trace of cementation." ;
    dcterms:modified "2024-09-30T00:17:28"^^xsd:dateTime ;
    dcterms:relation "Department of Environment and Heritage, NSW Government (2017). Glossary of Terms used in Soil and Landscape Science, Office of Environment and Heritage, ISBN 978-1-76039-930-6, pp. 92" ;
    dcterms:source "Department of Environment and Heritage, NSW Government (2017). Glossary of Terms used in Soil and Landscape Science, Office of Environment and Heritage, ISBN 978-1-76039-930-6, pp. 92" ;
    skos:definition "A type of lithology whose parent material is of quartzite origin, i.e., metamorphosed rock in which quartz is the primary constituent." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
    skos:notation "220" ;
    skos:note "A type of lithology whose parent material is of quartzite origin, i.e., metamorphosed rock in which quartz is the primary constituent." ;
    skos:prefLabel "quartzite"@en ;
    skos:topConceptOf <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
