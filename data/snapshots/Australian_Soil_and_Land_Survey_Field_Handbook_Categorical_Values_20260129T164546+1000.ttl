    skos:prefLabel "backplain"@en ;
    skos:semanticRelation <http://anzsoil.org/def/au/asls/landform/landform-element-BKP>,
        <http://linked.data.gov.au/def/tern-cv/a349b1fd-de18-4e54-8fd7-1b8f6a58b16f> .

