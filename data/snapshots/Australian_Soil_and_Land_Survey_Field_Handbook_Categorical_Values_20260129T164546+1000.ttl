<http://linked.data.gov.au/def/tern-cv/fdf0c6fa-b903-4c79-ba5f-f1a6acfe0777> a skos:Concept ;
    rdfs:label "emergent"@en ;
    dcterms:created "2024-10-28T02:07:44"^^xsd:dateTime ;
    dcterms:date "2024-10-28T02:07:44"^^xsd:dateTime,
        "2025-09-19T04:11:11"^^xsd:dateTime ;
    dcterms:description "An emergent species is defined as a species that emerges above the overstorey and occupies a stratum that has a canopy cover less than 5%. Emergents are always in a layer taller than the dominant structure and therefore cannot be a part of the dominant structural layer eg. Banksia ornata shrubland with Eucalyptus arenacea emergents." ;
    dcterms:modified "2025-09-19T04:11:11"^^xsd:dateTime ;
    dcterms:relation "National Committee on Soil, Terrain (Australia), & CSIRO Publishing. (2009). Australian soil and land survey field handbook (No.1). CSIRO PUBLISHING. Third Edition" ;
    dcterms:source "National Committee on Soil, Terrain (Australia), & CSIRO Publishing. (2009). Australian soil and land survey field handbook (No.1). CSIRO PUBLISHING. Third Edition" ;
    skos:definition "Emergent layer comprises of very tall trees (above 28m), with a crown cover of 3% and crown separation ratio of 4.0. " ;
    skos:historyNote "Added this collection based on the Third Edition of the 'Yellow Book' (Australian soil and land survey field handbook)" ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
    skos:notation "E" ;
    skos:note "Added this collection based on the Third Edition of the 'Yellow Book' (Australian soil and land survey field handbook)",
        "Emergent layer comprises of very tall trees (above 28m), with a crown cover of 3% and crown separation ratio of 4.0. " ;
    skos:prefLabel "emergent"@en ;
    skos:topConceptOf <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
    ns1:isMemberOf <http://linked.data.gov.au/def/tern-cv/6e5ce9f0-0774-4c04-b167-09527b196d86> .

