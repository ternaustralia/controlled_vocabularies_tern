<http://linked.data.gov.au/def/tern-cv/e9efee0c-63ad-4fbc-99e0-c4c645d5bb78> a skos:Concept ;
    rdfs:label "parabolic dune"@en ;
    dcterms:date "2025-09-16T03:43:32"^^xsd:dateTime ;
    dcterms:modified "2025-09-16T03:43:32"^^xsd:dateTime ;
    skos:closeMatch <http://anzsoil.org/def/au/asls/landform/landform-element-DUP>,
        <http://linked.data.gov.au/def/tern-cv/e9efee0c-63ad-4fbc-99e0-c4c645d5bb78> ;
    skos:definition "sand dune with a long, scoop-shaped form, convex in the downwind direction so that its horns point upwind, whose ground plan approximates the form of a parabola. The dunes left behind can be referred to as trailing arms. Where many such dunes have traversed an area, these can give the appearance of linear dunes."@en ;
    skos:exactMatch <http://anzsoil.org/def/au/asls/landform/landform-element-DUP>,
        <http://linked.data.gov.au/def/tern-cv/e9efee0c-63ad-4fbc-99e0-c4c645d5bb78> ;
    skos:mappingRelation <http://anzsoil.org/def/au/asls/landform/landform-element-DUP>,
        <http://linked.data.gov.au/def/tern-cv/e9efee0c-63ad-4fbc-99e0-c4c645d5bb78> ;
    skos:notation "DUP" ;
    skos:note "sand dune with a long, scoop-shaped form, convex in the downwind direction so that its horns point upwind, whose ground plan approximates the form of a parabola. The dunes left behind can be referred to as trailing arms. Where many such dunes have traversed an area, these can give the appearance of linear dunes."@en ;
    skos:prefLabel "parabolic dune"@en ;
    skos:semanticRelation <http://anzsoil.org/def/au/asls/landform/landform-element-DUP>,
        <http://linked.data.gov.au/def/tern-cv/e9efee0c-63ad-4fbc-99e0-c4c645d5bb78> .

