<http://linked.data.gov.au/def/tern-cv/b704b8ee-0631-423f-9c1f-c4d1efb1f421> a skos:Concept ;
    rdfs:label "haematite"@en ;
    dcterms:created "2024-09-27T00:53:26"^^xsd:dateTime ;
    dcterms:date "2024-09-27T00:53:26"^^xsd:dateTime,
        "2024-09-30T00:14:31"^^xsd:dateTime ;
    dcterms:description "Hematite is a heavy and relatively hard oxide mineral, ferric oxide (Fe<sub>2</sub>O<sub>3</sub>), that constitutes the most important iron ore because of its high iron content (70 percent) and its abundance. Much hematite occurs in a soft, fine-grained, earthy form called red ochre or ruddle. Intermediate between these types are compact varieties, often with a reniform surface (kidney ore) or a fibrous structure (pencil ore). Red ochre is used as a paint pigment; a purified form, rouge, is used to polish plate glass."^^rdf:HTML ;
    dcterms:modified "2024-09-30T00:14:31"^^xsd:dateTime ;
    dcterms:relation "Britannica, T. Editors of Encyclopaedia (2024, July 2). hematite. Encyclopedia Britannica. https://www.britannica.com/science/hematite" ;
    dcterms:source "Britannica, T. Editors of Encyclopaedia (2024, July 2). hematite. Encyclopedia Britannica. https://www.britannica.com/science/hematite" ;
    skos:definition "A type of lithology whose parent material is of iron oxide origin." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
    skos:notation "260" ;
    skos:note "A type of lithology whose parent material is of iron oxide origin." ;
    skos:prefLabel "haematite"@en ;
    skos:topConceptOf <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
    ns1:isMemberOf <http://linked.data.gov.au/def/tern-cv/484ba140-52ca-4732-be9a-6a6274daf072>,
        <http://linked.data.gov.au/def/tern-cv/ea7a1310-763d-45c1-a695-d4c4f6fe20c0> .

