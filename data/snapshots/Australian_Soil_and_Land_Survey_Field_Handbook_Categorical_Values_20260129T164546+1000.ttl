        <http://linked.data.gov.au/def/tern-cv/ea7a1310-763d-45c1-a695-d4c4f6fe20c0> .

<http://linked.data.gov.au/def/tern-cv/80ad03a6-6ac1-41a8-8d7b-0af0db165c95> a skos:Concept ;
    rdfs:label "silicrete"@en ;
    dcterms:created "2024-09-26T06:08:38"^^xsd:dateTime ;
    dcterms:date "2024-09-26T06:08:38"^^xsd:dateTime,
        "2024-09-30T00:18:03"^^xsd:dateTime ;
    dcterms:description "Strongly indurated siliceous material cemented by and largely composed of forms of silica including quartz, chalcedony, opal and chert." ;
    dcterms:modified "2024-09-30T00:18:03"^^xsd:dateTime ;
    dcterms:relation "Department of Environment and Heritage, NSW Government (2017). Glossary of Terms used in Soil and Landscape Science, Office of Environment and Heritage, ISBN 978-1-76039-930-6, pp. 92" ;
