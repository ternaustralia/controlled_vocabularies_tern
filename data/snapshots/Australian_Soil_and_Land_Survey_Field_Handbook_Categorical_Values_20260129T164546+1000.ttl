    dcterms:date "2024-09-26T06:06:35"^^xsd:dateTime,
        "2024-09-30T00:14:45"^^xsd:dateTime ;
    dcterms:description "A soil in which an indurated iron-rich layer usually overlies a mottled clay and a pallid clay." ;
