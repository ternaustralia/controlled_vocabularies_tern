    skos:notation "170" ;
    skos:note "A type of lithology whose parent material is of silcrete origin." ;
    skos:prefLabel "silicrete"@en ;
    skos:topConceptOf <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
