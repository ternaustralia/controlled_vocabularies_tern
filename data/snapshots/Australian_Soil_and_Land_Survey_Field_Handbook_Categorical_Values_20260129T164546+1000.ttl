<http://linked.data.gov.au/def/tern-cv/aa9a496d-ea39-46ff-8248-6adc725c1d07> a skos:Concept ;
    rdfs:label "basalt"@en ;
    dcterms:created "2024-09-27T02:16:55"^^xsd:dateTime ;
    dcterms:date "2024-09-27T02:16:55"^^xsd:dateTime,
        "2024-09-30T00:13:56"^^xsd:dateTime ;
    dcterms:description "A fine-grained, dark-coloured basic volcanic rock primarily composed of plagioclase and pyroxene (low silica and high ferromagnesian content)." ;
    dcterms:modified "2024-09-30T00:13:56"^^xsd:dateTime ;
    dcterms:relation "Department of Environment and Heritage, NSW Government (2017). Glossary of Terms used in Soil and Landscape Science, Office of Environment and Heritage, ISBN 978-1-76039-930-6, pp. 92" ;
    dcterms:source "Department of Environment and Heritage, NSW Government (2017). Glossary of Terms used in Soil and Landscape Science, Office of Environment and Heritage, ISBN 978-1-76039-930-6, pp. 92" ;
    skos:definition "A type of lithology whose parent material is of volcanic origin with a high ferro-mangnesium content." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
    skos:notation "320" ;
    skos:note "A type of lithology whose parent material is of volcanic origin with a high ferro-mangnesium content." ;
    skos:prefLabel "basalt"@en ;
    skos:topConceptOf <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
