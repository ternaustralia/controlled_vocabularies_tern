<http://linked.data.gov.au/def/tern-cv/8bd3dde6-e14e-41f5-9121-81ed6b05d42a> a skos:Concept ;
    rdfs:label "igneous"@en ;
    dcterms:created "2024-09-27T01:01:31"^^xsd:dateTime ;
    dcterms:date "2024-09-27T01:01:31"^^xsd:dateTime,
        "2024-09-30T00:14:38"^^xsd:dateTime ;
    dcterms:description "Rocks which have solidified from molten magma at or below the earth's surface; grains are characteristically crystalline and interlocking; crystal size decreases with increasing rate of cooling of the molten rock material." ;
    dcterms:modified "2024-09-30T00:14:38"^^xsd:dateTime ;
    dcterms:relation "Department of Environment and Heritage, NSW Government (2017). Glossary of Terms used in Soil and Landscape Science, Office of Environment and Heritage, ISBN 978-1-76039-930-6, pp. 92" ;
    dcterms:source "Department of Environment and Heritage, NSW Government (2017). Glossary of Terms used in Soil and Landscape Science, Office of Environment and Heritage, ISBN 978-1-76039-930-6, pp. 92" ;
    skos:definition "A type of lithology whose parent material is of igneous rocks." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
    skos:notation "300" ;
    skos:note "A type of lithology whose parent material is of igneous rocks." ;
    skos:prefLabel "igneous"@en ;
    skos:topConceptOf <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
