<http://linked.data.gov.au/def/tern-cv/e925f8a8-086b-4479-8d3b-b75740eba9d9>
    a skos:Concept ;
    rdfs:label "mid stratum" ;
    dcterms:created "2022-06-06T12:11:08+00:00"^^xsd:dateTime ;
    dcterms:date
        "2026-02-10T03:13:58"^^xsd:dateTime ,
        "2022-06-06T12:11:08+00:00"^^xsd:dateTime ;
    dcterms:description "This is the middle vegetation stratum, above the ground layer and comprises growth forms such as Shrubs, low trees, mallee shrubs, vines, (low shrubs, tall grasses, tall forbs, tall sedges), grass-trees, tree-ferns, cycads, palms. May also include epiphytes, lichens." ;
    dcterms:modified "2026-02-10T03:13:58"^^xsd:dateTime ;
    dcterms:relation "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)." ;
    dcterms:source "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)." ;
    skos:definition "Mid or sub-stratum (M) is the vegetation stratum that constitutes the middle three layers (M1, M2 and M3) of the vegetation structure (if only one mid layer occurs it is coded M1)" ;
    skos:notation "M" ;
    skos:note "Mid or sub-stratum (M) is the vegetation stratum that constitutes the middle three layers (M1, M2 and M3) of the vegetation structure (if only one mid layer occurs it is coded M1)" ;
    skos:prefLabel "mid stratum" ;
.

