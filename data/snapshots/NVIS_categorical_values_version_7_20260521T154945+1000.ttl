    a skos:Concept ;
    rdfs:label "height class 3" ;
    dcterms:created "2022-06-06T12:11:08+00:00"^^xsd:dateTime ;
    dcterms:date
        "2026-02-09T00:28:38"^^xsd:dateTime ,
        "2022-06-06T12:11:08+00:00"^^xsd:dateTime ;
    dcterms:modified "2026-02-09T00:28:38"^^xsd:dateTime ;
    dcterms:relation "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)." ;
    dcterms:source "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)." ;
    skos:definition "NVIS height class 3 comprises of vegetation heights in the range between 1 - 2 metres. These include growth forms such as mid sized shrub, heath shrub, chenopod shrub, ferns, samphire shrub, cycad, tree-fern, grass-tree and palm (multi-stemmed). They can also include some of the mid-tussock grass, hummock grass, other grass, sedge, rush, forbs and vine (G)." ;
    skos:notation "3" ;
    skos:note "NVIS height class 3 comprises of vegetation heights in the range between 1 - 2 metres. These include growth forms such as mid sized shrub, heath shrub, chenopod shrub, ferns, samphire shrub, cycad, tree-fern, grass-tree and palm (multi-stemmed). They can also include some of the mid-tussock grass, hummock grass, other grass, sedge, rush, forbs and vine (G)." ;
    skos:prefLabel "height class 3" ;
.

