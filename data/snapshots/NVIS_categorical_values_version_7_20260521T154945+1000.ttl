<http://linked.data.gov.au/def/tern-cv/bd6f696c-cc8d-4096-b291-a40c834a5bee>
    a skos:Collection ;
    rdfs:label "NVIS categorical values version 7"@en ;
    dcterms:created "2022-06-06T01:18:34"^^xsd:dateTime ;
    dcterms:date
        "2022-06-06T01:18:34"^^xsd:dateTime ,
        "2026-04-15T04:27:42"^^xsd:dateTime ;
    dcterms:description "The Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. (sometimes referred to as NVIS version 7) was originally developed to underpin the National Land and Water Resources Audit (NLWRA) assessment of vegetation in Australia (NLWRA, 2001)1. The NVIS was developed as a technical framework and database in partnership with the Australian, state and territory governments. " ;
    dcterms:modified "2026-04-15T04:27:42"^^xsd:dateTime ;
    dcterms:relation "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)" ;
    dcterms:source "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)" ;
    skos:definition "The National Vegetation Information System (NVIS) categorical values is a classifier representing the categorical variables listed in the Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0." ;
    skos:member
        <http://linked.data.gov.au/def/tern-cv/0738e5be-0c86-4e49-8d5b-7a238ec6a586> ,
        <http://linked.data.gov.au/def/tern-cv/26b7e0dc-5f68-4582-870e-2a4837a0e932> ,
        <http://linked.data.gov.au/def/tern-cv/2aa40711-7c6d-506f-ae57-90551476d521> ,
        <http://linked.data.gov.au/def/tern-cv/30fd1935-85ca-4174-b2f8-171c2ccdf22c> ,
        <http://linked.data.gov.au/def/tern-cv/765499b7-ff0d-44ff-b440-2bf9e82cc731> ,
        <http://linked.data.gov.au/def/tern-cv/a4489e4d-4576-4f8f-9d6b-f1d5a6770274> ,
        <http://linked.data.gov.au/def/tern-cv/b4879c30-c473-5d8c-9310-17fa0a258fe6> ,
        <http://linked.data.gov.au/def/tern-cv/b91ed8f5-9b2f-4510-ace1-2bc3fe51e1cb> ,
        <http://linked.data.gov.au/def/tern-cv/db52882b-d7f2-4149-8af4-91218cce2f0d> ;
    skos:note "The National Vegetation Information System (NVIS) categorical values is a classifier representing the categorical variables listed in the Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0." ;
    skos:prefLabel "NVIS categorical values version 7"@en ;
