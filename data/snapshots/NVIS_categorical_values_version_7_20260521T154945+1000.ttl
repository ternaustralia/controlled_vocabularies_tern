<http://linked.data.gov.au/def/tern-cv/d8d5fd58-655e-4c70-94d3-715295da068e>
    a skos:Concept ;
    rdfs:label
        "% cover" ,
        "percent vegetation cover" ,
        "percent cover"@en ;
    dcterms:created "2026-02-06T00:57:30"^^xsd:dateTime ;
    dcterms:date
        "2026-02-06T00:57:30"^^xsd:dateTime ,
        "2026-02-06T01:03:28"^^xsd:dateTime ;
    dcterms:modified "2026-02-06T01:03:28"^^xsd:dateTime ;
    dcterms:relation "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)." ;
    dcterms:source "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)." ;
    skos:altLabel
        "% cover" ,
        "percent vegetation cover" ;
    skos:definition "The percentage cover is defined as the percentage of a strictly defined plot area, covered by vegetation. This can be an estimate and is a less precise measure than using, for example, a point intercept transect method on ground layer, or overstorey vegetative cover. That is, for precisely measured values (e.g. crown densitometer or point intercept transects) the value measured would be 'foliage' cover. Where less precise or qualitative measures are used these will most probably be recorded as 'percentage' cover." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
    skos:note "The percentage cover is defined as the percentage of a strictly defined plot area, covered by vegetation. This can be an estimate and is a less precise measure than using, for example, a point intercept transect method on ground layer, or overstorey vegetative cover. That is, for precisely measured values (e.g. crown densitometer or point intercept transects) the value measured would be 'foliage' cover. Where less precise or qualitative measures are used these will most probably be recorded as 'percentage' cover." ;
    skos:prefLabel "percent cover"@en ;
    skos:topConceptOf <http://linked.data.gov.au/def/tern-cv/9bf5755a-0ccb-4575-afde-35bf99b8f7b0> ;
.

