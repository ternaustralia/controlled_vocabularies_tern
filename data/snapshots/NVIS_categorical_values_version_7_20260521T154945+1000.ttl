    dcterms:date
        "2022-06-06T01:18:34"^^xsd:dateTime ,
        "2026-02-04T22:07:41"^^xsd:dateTime ;
    dcterms:modified "2026-02-04T22:07:41"^^xsd:dateTime ;
    dcterms:relation "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)" ;
    dcterms:source "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)" ;
    skos:definition "A categorical measure used within the National Vegetation Information System (NVIS) to describe the estimated percentage of foliage cover contributed by a vegetation stratum, expressed as broad cover classes rather than exact percentages." ;
    skos:member
        <http://linked.data.gov.au/def/tern-cv/31c70b45-01ec-44ba-834c-7342d7a37206> ,
        <http://linked.data.gov.au/def/tern-cv/5ca50527-40da-4694-804f-42372a6513b7> ,
        <http://linked.data.gov.au/def/tern-cv/64147711-2644-4e31-b649-b5a54d0717a7> ,
        <http://linked.data.gov.au/def/tern-cv/93287e85-43c5-405b-bfc3-19f62802713b> ,
        <http://linked.data.gov.au/def/tern-cv/996311df-2a44-44be-b8d9-89b3d6c91406> ,
        <http://linked.data.gov.au/def/tern-cv/a7e1fd86-5d75-4d70-9ed0-5079845ed53d> ,
        <http://linked.data.gov.au/def/tern-cv/d36e262e-9443-4ff0-9beb-63770b015756> ;
    skos:note
        "A categorical measure used within the National Vegetation Information System (NVIS) to describe the estimated percentage of foliage cover contributed by a vegetation stratum, expressed as broad cover classes rather than exact percentages." ,
        "NVIS Cover Classes provide a standardised way to represent vegetation density across Australia and are applied to each structural stratum (e.g., upper, mid, ground) in NVIS vegetation descriptions." ;
    skos:prefLabel "NVIS cover class categories"@en ;
    skos:scopeNote "NVIS Cover Classes provide a standardised way to represent vegetation density across Australia and are applied to each structural stratum (e.g., upper, mid, ground) in NVIS vegetation descriptions." ;
.

