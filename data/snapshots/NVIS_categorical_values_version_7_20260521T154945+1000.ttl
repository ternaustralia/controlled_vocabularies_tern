<http://linked.data.gov.au/def/tern-cv/08f02a64-cd97-4aac-bc3a-a6e270dbdf51>
    a skos:Concept ;
    rdfs:label "height class 7" ;
    dcterms:created "2022-06-06T12:11:08+00:00"^^xsd:dateTime ;
    dcterms:date
        "2026-02-09T00:42:50"^^xsd:dateTime ,
        "2022-06-06T12:11:08+00:00"^^xsd:dateTime ;
    dcterms:modified "2026-02-09T00:42:50"^^xsd:dateTime ;
    dcterms:relation "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)." ;
    dcterms:source "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)." ;
    skos:definition "NVIS height class 7 comprises of vegetation heights in the range 10 - 30 metres. These include growth forms such mid-sized tree, vine (M & U), palm (single-stemmed) and tall tree mallee, and mallee shrub." ;
    skos:notation "7" ;
    skos:note "NVIS height class 7 comprises of vegetation heights in the range 10 - 30 metres. These include growth forms such mid-sized tree, vine (M & U), palm (single-stemmed) and tall tree mallee, and mallee shrub." ;
    skos:prefLabel "height class 7" ;
.

