<http://linked.data.gov.au/def/tern-cv/044f129a-c9dd-42f9-a7ba-3800b0fd5320> a skos:Concept ;
    rdfs:label "ground stratum" ;
    dcterms:created "2022-06-06T12:11:08+00:00"^^xsd:dateTime ;
    dcterms:date "2025-09-17T21:51:54"^^xsd:dateTime,
        "2022-06-06T12:11:08+00:00"^^xsd:dateTime ;
    dcterms:description "This is the lower or ground layer of the vegetation stratum and includes growth forms like Grasses, forbs, sedges, rushes, vines, lichens, epiphytes, low shrubs, ferns, bryophytes, cycads, grass-trees, aquatics, seagrasses." ;
    dcterms:modified "2025-09-17T21:51:54"^^xsd:dateTime ;
    dcterms:relation "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)." ;
    dcterms:source "NVIS Technical Working Group (2017) Australian Vegetation Attribute Manual: National Vegetation Information System, Version 7.0. Department of the Environment and Energy, Canberra. Prep by Bolton, M.P., deLacey, C. and Bossard, K.B. (Eds)." ;
    skos:definition "Lower, ground (if only one ground layer occurs it is coded G1)" ;
    skos:notation "G" ;
    skos:note "Lower, ground (if only one ground layer occurs it is coded G1)" ;
    skos:prefLabel "ground stratum" .

